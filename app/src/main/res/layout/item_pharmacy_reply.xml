<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Pharmacy Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivPharmacyAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#2E7D32"
                android:contentDescription="Pharmacy Avatar"
                android:padding="8dp"
                android:src="@drawable/ic_local_pharmacy"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPharmacyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Botika ng Barangay"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPharmacyVerifiedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:drawablePadding="3dp"
                        android:drawableStart="@drawable/ic_verified_14"
                        android:drawableTint="#2E7D32"
                        android:text="Verified"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPharmacyLocationDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marawoy, Lipa City • 10 mins ago"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAvailabilityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:backgroundTint="#E8F5E9"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="AVAILABLE"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Price & Note -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Price: ₱8.00 / tablet"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="We have 5 boxes in stock at our Marawoy branch. Open until 9 PM."
            android:textColor="@color/black"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider_color" />

        <!-- Actions Row: Call, Chat & View Profile / Map -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.PharmaFind.Button.Small"
                android:id="@+id/btnContact"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                app:icon="@drawable/ic_call"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                android:text="Call" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.PharmaFind.Button.Small"
                android:id="@+id/btnChatWithPharmacy"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                app:icon="@drawable/ic_chat_bubble_outline"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                android:text="Chat" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.PharmaFind.Button.Small"
                android:id="@+id/btnViewPharmacyProfile"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingHorizontal="10dp"
                android:textSize="12sp"
                app:icon="@drawable/ic_location_on"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                android:text="Map &amp; Profile" />

        </LinearLayout>

        <!-- Main action on its own full-width row (only shown to the request owner) -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.PharmaFind.Button.Small.Filled"
            android:id="@+id/btnAcceptOffer"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            app:icon="@drawable/ic_check_circle"
            android:text="Select Pharmacy" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>