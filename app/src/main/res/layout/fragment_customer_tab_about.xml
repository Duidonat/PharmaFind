<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Details"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvCityVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="City: Lipa City"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBarangayVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Barangay: Marawoy"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDistrictVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="District / Purok: Villa San Jose"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvUsernameVal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username: customer1"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bio / Notes"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etBio"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/edittext_background"
            android:hint="Add a short bio or notes about your medical needs..."
            android:padding="12dp"
            android:textColor="@color/black"
            android:textColorHint="@color/text_gray"
            android:textSize="14sp"
            android:gravity="top|start" />

    </LinearLayout>
</ScrollView>