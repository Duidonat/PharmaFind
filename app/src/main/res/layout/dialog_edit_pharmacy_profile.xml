<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="20dp">

    <!-- Title (Threads Style Edit Profile) -->
    <TextView
        android:id="@+id/tvEditProfileTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Pharmacy Profile"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnCloseEditProfile"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close"
        android:src="@drawable/ic_close"
        app:tint="@color/text_gray"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvEditProfileTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Pharmacy Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pharmacy / Store Name"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPharmacyNameEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_background"
                android:hint="Pharmacy Name"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <!-- Bio / Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Store Bio / Description"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBioEdit"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_background"
                android:gravity="top|start"
                android:hint="e.g. Registered branch in Marawoy offering discounts..."
                android:inputType="textMultiLine"
                android:padding="12dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <!-- Operating Hours & Schedule Picker -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Operating Hours &amp; Schedule"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Time Pickers Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.PharmaFind.Button.Outlined"
                    android:id="@+id/btnOpeningTime"
                    android:layout_width="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="Opening: 8:00 AM" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.PharmaFind.Button.Outlined"
                    android:id="@+id/btnClosingTime"
                    android:layout_width="0dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Closing: 9:00 PM" />

            </LinearLayout>

            <!-- Day / Schedule Selection Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMonSun"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Mon - Sun"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMonSat"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon - Sat"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMonFri"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mon - Fri"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip247"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 / 7"
                        android:textSize="11sp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCustomDates"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipIcon="@drawable/ic_event"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/primary_teal"
                        android:text="Select Date Range"
                        android:textSize="11sp" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <EditText
                android:id="@+id/etHoursEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_background"
                android:hint="Operating Hours Schedule"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <!-- Contact Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Number"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etContactEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_background"
                android:hint="Phone / Mobile number"
                android:inputType="phone"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <!-- Store address (same fields the pharmacy filled in when registering) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCityEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_background"
                android:hint="City"
                android:inputType="text"
                android:maxLength="100"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBarangayEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_background"
                android:hint="Barangay"
                android:inputType="text"
                android:maxLength="100"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="District / Purok (optional)"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDistrictEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/edittext_background"
                android:hint="District or Purok"
                android:inputType="text"
                android:maxLength="100"
                android:paddingHorizontal="12dp"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider_color" />

            <!-- Map Location Pin Section (Threads Style Profile Setting) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_location_on_16"
                android:drawableTint="@color/primary_teal"
                android:text="Store Location Pin (Google Maps)"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPinCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Current Pin: Not Set"
                android:textColor="@color/text_gray"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etLatEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:hint="Latitude (e.g. 13.9412)"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etLngEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:hint="Longitude (e.g. 121.1631)"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.PharmaFind.Button.Outlined"
                android:id="@+id/btnUseCurrentGPSPin"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                app:icon="@drawable/ic_my_location"
                android:text="Auto-Detect My Current GPS Location Pin" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.PharmaFind.Button.Outlined"
                android:id="@+id/btnPickPharmacyMap"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                app:icon="@drawable/ic_map"
                android:text="Pick Store Location Manually on Map" />

            <!-- Save Profile Button -->
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.PharmaFind.Button"
                android:id="@+id/btnSavePharmacyProfile"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:text="Save Profile &amp; Location Pin" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>