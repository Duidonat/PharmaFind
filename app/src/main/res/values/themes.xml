<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- Light only for now: the layouts hard-code white backgrounds and black text, so
         following the phone's dark mode made chips and the bottom menu unreadable. -->
    <style name="Base.Theme.PharmaFind" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <!-- Brand colors live here (not in Base) so they apply no matter which Base is used.
         Without them, Material falls back to its default purple for checkboxes, chips,
         the bottom menu, text cursors and date/time pickers. -->
    <style name="Theme.PharmaFind" parent="Base.Theme.PharmaFind">
        <item name="colorPrimary">@color/primary_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/teal_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary_teal</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/teal_container</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/surface_container_low</item>
        <item name="colorSurfaceContainer">@color/surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_container_highest</item>
        <!-- Keep white cards and the bottom menu pure white. Material 3 otherwise tints raised
             surfaces that match colorSurface, which turned them grey-teal. -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Soft slide-and-fade between screens -->
        <item name="android:windowAnimationStyle">@style/Animation.PharmaFind.Activity</item>
        <!-- Snackbar (message) colors: dark teal with white text -->
        <item name="colorSurfaceInverse">@color/primary_dark</item>
        <item name="colorOnSurfaceInverse">@color/white</item>
    </style>
</resources>
