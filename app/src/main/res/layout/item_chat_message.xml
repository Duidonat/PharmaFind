<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Container for Message Bubble -->
    <LinearLayout
        android:id="@+id/layoutBubbleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMessageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="@color/primary_teal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <TextView
                    android:id="@+id/tvSenderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sender"
                    android:textColor="#E0F2F1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMessageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="260dp"
                    android:text="Message body..."
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvMessageTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="12:00 PM"
                    android:textColor="#B2DFDB"
                    android:textSize="10sp" />

                <!-- Baymax Care Satisfaction Buttons (Shown to customer on care inquiry) -->
                <LinearLayout
                    android:id="@+id/layoutSatisfactionActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.PharmaFind.Button.Small.Filled"
                        android:id="@+id/btnSatisfiedYes"
                        android:layout_width="match_parent"
                        android:text="Yes, I am satisfied!"
                        app:backgroundTint="#2E7D32"
                        app:icon="@drawable/ic_check_circle" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.PharmaFind.Button.Small"
                        android:id="@+id/btnSatisfiedNo"
                        android:layout_width="match_parent"
                        android:layout_marginTop="4dp"
                        android:text="Not yet"
                        android:textColor="@color/black" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>