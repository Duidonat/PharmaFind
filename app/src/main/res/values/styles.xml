<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared button styles. Use these instead of setting height, corners and colors on each
         button, so every screen's buttons match. -->

    <!-- Main action (Log In, Register, Save, Post, Confirm...): filled teal -->
    <style name="Widget.PharmaFind.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">@color/primary_teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Secondary action (Add Photo, My GPS, Call Store...): teal outline -->
    <style name="Widget.PharmaFind.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="strokeColor">@color/primary_teal</item>
        <item name="android:textColor">@color/primary_teal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Small secondary action inside cards and tabs (Call, Profile & Map, Edit): teal outline -->
    <style name="Widget.PharmaFind.Button.Small" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/primary_teal</item>
        <item name="android:textColor">@color/primary_teal</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Small main action (Select Pharmacy, the landing screen's Log In / Register): filled teal -->
    <style name="Widget.PharmaFind.Button.Small.Filled" parent="Widget.Material3.Button">
        <item name="android:layout_height">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/primary_teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
