<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:padding="16dp">

    <!-- Search Input -->
    <EditText
        android:id="@+id/etSearchPharmacyFeed"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edittext_background"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="12dp"
        android:hint="Search medicine name or area..."
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="@color/black"
        android:textColorHint="@color/text_gray"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etSearchPharmacyFeed">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPharmacyFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPharmacyAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Requests" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPharmacyOpen"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPharmacyFulfilled"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fulfilled" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Inquiries RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPharmacyInquiries"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollChips" />

</androidx.constraintlayout.widget.ConstraintLayout>
