<?xml version="1.0" encoding="utf-8"?>
<!-- Shared text field background: soft border on white, thicker teal border while typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/primary_teal" />
            <solid android:color="@color/white" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/field_border" />
            <solid android:color="@color/white" />
        </shape>
    </item>
</selector>
