<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipToPadding="false"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Decorative Background Elements -->

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="#DFF4F6"
        android:layout_marginTop="-150dp"
        android:layout_marginStart="-100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="#ECF9E8"
        android:layout_marginBottom="-100dp"
        android:layout_marginEnd="-80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="40dp"
        android:rotation="45"
        android:src="@drawable/decorative_pill"
        android:alpha="0.5"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:layout_width="60dp"
        android:layout_height="30dp"
        android:layout_marginTop="100dp"
        android:layout_marginStart="-20dp"
        android:rotation="-30"
        android:src="@drawable/decorative_pill"
        android:alpha="0.5"
        android:contentDescription="@null"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top Navigation -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.PharmaFind.Button.Small.Filled"
        android:id="@+id/btnRegister"
        android:layout_width="wrap_content"
        android:text="@string/register"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.PharmaFind.Button.Small.Filled"
        android:id="@+id/btnLoginTop"
        android:layout_width="wrap_content"
        android:text="@string/log_in"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@+id/btnRegister"
        app:layout_constraintBottom_toBottomOf="@+id/btnRegister"
        app:layout_constraintEnd_toStartOf="@+id/btnRegister" />

    <!-- Logo Section -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="80dp"
        android:src="@drawable/ic_pharmafind_logo"
        android:contentDescription="@string/logo_description"
        app:layout_constraintTop_toBottomOf="@id/btnRegister"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Text Section -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/medicine_locator"
        android:textColor="@color/primary_teal"
        android:letterSpacing="0.1"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pharma_find"
        android:textColor="@color/black"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/description"
        android:textColor="@color/text_gray"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="32dp" />

    <!-- Bottom Section -->
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.PharmaFind.Button"
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_marginBottom="24dp"
        android:text="@string/get_started"
        app:layout_constraintBottom_toTopOf="@id/llFooter" />

    <LinearLayout
        android:id="@+id/llFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/already_have_account"
            android:textColor="@color/text_gray" />

        <TextView
            android:id="@+id/tvLoginBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/log_in"
            android:textColor="@color/primary_teal"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>