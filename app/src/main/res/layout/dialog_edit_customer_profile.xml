<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Location &amp; GPS Pin"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_centerVertical="true" />

            <ImageButton
                android:id="@+id/btnCloseEditCustomerProfile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_gray" />

        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="City"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCityCustomerEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Barangay"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etBarangayCustomerEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="District / Area"
            android:textColor="@color/black"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etDistrictCustomerEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_background"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/tvCustomerPinCoordinates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Current Pin: Not Set"
            android:textColor="@color/primary_teal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etLatCustomerEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/edittext_background"
                android:hint="Latitude"
                android:inputType="numberDecimal|numberSigned"
                android:paddingHorizontal="8dp"
                android:textColor="@color/black"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLngCustomerEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/edittext_background"
                android:hint="Longitude"
                android:inputType="numberDecimal|numberSigned"
                android:paddingHorizontal="8dp"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseCustomerGPSPin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="🎯 Auto-Detect Current GPS Location"
            android:textAllCaps="false"
            android:textColor="@color/primary_teal"
            app:strokeColor="@color/primary_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickCustomerMap"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="🗺️ Pick Location Manually on Map"
            android:textAllCaps="false"
            android:textColor="@color/primary_teal"
            app:strokeColor="@color/primary_teal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveCustomerProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="Save Profile &amp; Location Pin"
            android:textAllCaps="false"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/primary_teal" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
